@@ -0,0 +1,98 @@
+import {
+  GraduationCap,
+  Users,
+  CalendarCheck,
+  ClipboardCheck,
+} from 'lucide-react';
+import { Link } from 'react-router-dom';
+import type { AdminDashboardData } from '../../../api/adminDashboardApi';
+export default function AdminOverview({
+  counts,
+}: {
+  counts: AdminDashboardData['counts'];
+}) {
+  const pending = counts.pendingInstructors + counts.pendingGroups;
+  const cards = [
+    {
+      label: 'مدرسان',
+      value: counts.instructors,
+      icon: GraduationCap,
+      hint: 'تعداد حساب‌های مدرس',
+    },
+    {
+      label: 'دانشجویان',
+      value: counts.students,
+      icon: Users,
+      hint: 'تعداد حساب‌های دانشجو',
+    },
+    {
+      label: 'آزمون‌های فعال',
+      value: counts.activeExams,
+      icon: CalendarCheck,
+      hint: 'زمان‌بندی‌شده و در حال برگزاری',
+    },
+    {
+      label: 'منتظر بررسی',
+      value: pending,
+      icon: ClipboardCheck,
+      hint: 'درخواست‌های مدرس و گروه',
+    },
+  ];
+  return (
+    <>
+      <section
+        aria-label="آمار سامانه"
+        className="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4"
+      >
+        {cards.map(({ label, value, icon: Icon, hint }) => (
+          <article
+            key={label}
+            className="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-gray-900"
+          >
+            <div className="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400">
+              <h2>{label}</h2>
+              <Icon
+                size={20}
+                aria-hidden="true"
+                className="text-brand-500 dark:text-brand-300"
+              />
+            </div>
+            <p className="my-3 text-3xl font-bold tabular-nums">
+              {value.toLocaleString('fa-IR')}
+            </p>
+            <p className="text-xs text-gray-500 dark:text-gray-400">{hint}</p>
+          </article>
+        ))}
+      </section>
+      <section className="mb-6 rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-gray-900">
+        <h2 className="mb-3 font-bold">نیازمند رسیدگی</h2>
+        {pending === 0 ? (
+          <p className="text-sm text-gray-500 dark:text-gray-400">
+            درخواست منتظر بررسی ندارید.
+          </p>
+        ) : (
+          <div className="grid gap-3 sm:grid-cols-2">
+            {counts.pendingInstructors > 0 && (
+              <Link
+                to="/instructor-approvals"
+                className="rounded-xl bg-brand-50 p-4 text-sm text-brand-700 dark:bg-brand-950/50 dark:text-brand-300"
+              >
+                {counts.pendingInstructors.toLocaleString('fa-IR')} درخواست
+                تأیید مدرس ←
+              </Link>
+            )}
+            {counts.pendingGroups > 0 && (
+              <Link
+                to="/settings"
+                className="rounded-xl bg-brand-50 p-4 text-sm text-brand-700 dark:bg-brand-950/50 dark:text-brand-300"
+              >
+                {counts.pendingGroups.toLocaleString('fa-IR')} درخواست تأیید
+                گروه ←
+              </Link>
+            )}
+          </div>
+        )}
+      </section>
+    </>
+  );
+}
