+// تصویر پروفایل: سرور تصویر را اعتبارسنجی می‌کند (نوع واقعی، حجم ≤ ۵MB) و کاربر به‌روزشده را برمی‌گرداند
+export async function uploadAvatar(file: File): Promise<UpdateAvatarResult> {
+  try {
+    const formData = new FormData();
