generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SuperAdmin
  Instructor
  Student
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
}

enum OtpChannel {
  SMS
  EMAIL
}

enum VideoSourceType {
  LINK
  UPLOAD
}

enum PlanId {
  free
  gold
  platinum
  vip
}

enum NotificationIcon {
  info
  people
  award
}

enum CategoryStatus {
  Pending
  Approved
}

enum QuestionDifficulty {
  Easy
  Medium
  Hard
}

enum ExamStatus {
  Draft
  Published
}

enum PaymentStatus {
  Pending
  Success
  Failed
  Refunded
}

model User {
  id                  String         @id @default(cuid())
  phone               String?        @unique
  email               String?        @unique
  passwordHash        String?
  name                String?
  role                Role           @default(Student)
  googleId            String?        @unique
  phoneVerifiedAt     DateTime?
  emailVerifiedAt     DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  username            String?        @unique
  usernameNormalized  String?        @unique
  approvalStatus      ApprovalStatus @default(Approved)
  onboardingCompleted Boolean        @default(false)
  organizationName    String?
  avatarKey           String?

  otpCodes           OtpCode[]
  instructedGroups   Group[]            @relation("GroupInstructor")
  groupsMember       Group[]            @relation("GroupMembers")
  ownedExams         Exam[]             @relation("ExamOwner")
  attempts           ExamAttempt[]
  subscriptions      Subscription[]
  payments           Payment[]
  notifications      Notification[]
  notificationReads  NotificationRead[]
  proposedCategories Category[]
  questionBanks      QuestionBank[]
  handouts           Handout[]
  blogPosts          BlogPost[]         @relation("BlogAuthor")
  siteContentEdits   SiteContent[]      @relation("SiteContentEditor")
  practiceSets       PracticeSet[]
  practiceAttempts   PracticeAttempt[]
  adminActions       AdminAuditLog[]    @relation("AdminActor")

  @@map("users")
}

model OtpCode {
  id         String     @id @default(cuid())
  identifier String
  channel    OtpChannel
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  userId     String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, purpose])
  @@map("otp_codes")
}

model Group {
  approvalStatus ApprovalStatus @default(Approved)
  id           String   @id @default(cuid())
  name         String
  category     String
  joinCode     String   @unique
  instructorId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor     User            @relation("GroupInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  students       User[]          @relation("GroupMembers")
  exams          Exam[]          @relation("GroupExams")
  lessonSessions LessonSession[] @relation("GroupSessions")
  practiceAccess PracticeSetGroup[]
  handouts       Handout[]

  @@index([instructorId])
  @@map("groups")
  @@index([approvalStatus, createdAt])
}

model LessonSession {
  id            String          @id @default(cuid())
  category      String
  title         String
  description   String
  videoType     VideoSourceType
  videoUrl      String?
  videoFileName String?
  // Private storage object key, despite the legacy field name.
  videoObjectUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  groups      Group[]            @relation("GroupSessions")
  attachments LessonAttachment[]

  @@map("lesson_sessions")
}

model LessonAttachment {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileSize  Int
  sessionId String
  createdAt DateTime @default(now())

  session LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("lesson_attachments")
}

model Handout {
  id           String   @id @default(cuid())
  title        String
  description  String?
  category     String
  groupId      String?
  instructorId String
  fileName     String
  fileUrl      String
  fileSize     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group      Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  instructor User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
  @@index([groupId])
  @@index([category])
  @@map("handouts")
}

// Store raw Markdown and a public cover object key; serialize the URL separately.
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  contentMarkdown String
  coverImageKey   String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author User @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([published, publishedAt])
  @@map("blog_posts")
}

// Section-specific JSON is validated by cmsSchemas.
model SiteContent {
  id          String   @id @default(cuid())
  section     String   @unique
  data        Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("SiteContentEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_contents")
}

model Category {
  id             String         @id @default(cuid())
  name           String
  nameNormalized String         @unique
  status         CategoryStatus @default(Pending)
  proposedById   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  proposedBy User? @relation(fields: [proposedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("categories")
}

model Exam {
  id              String     @id @default(cuid())
  title           String
  category        String
  scheduledAt     DateTime
  durationMinutes Int
  allowReview     Boolean    @default(true)
  status          ExamStatus @default(Draft)
  // Ownership is independent of group membership.
  instructorId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor User           @relation("ExamOwner", fields: [instructorId], references: [id], onDelete: Restrict)
  groups     Group[]        @relation("GroupExams")
  attempts   ExamAttempt[]
  questions  ExamQuestion[]

  @@index([instructorId])
  @@map("exams")
}

model QuestionBank {
  id           String   @id @default(cuid())
  name         String
  category     String
  instructorId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor User       @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  questions  Question[]

  @@index([instructorId])
  @@index([category])
  @@map("question_banks")
}

model Question {
  id                 String             @id @default(cuid())
  text               String
  options            String[]
  correctOptionIndex Int
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  bankId             String
  difficulty         QuestionDifficulty @default(Medium)

  bank          QuestionBank   @relation(fields: [bankId], references: [id], onDelete: Cascade)
  practiceQuestions PracticeQuestion[]
  examQuestions ExamQuestion[]

  @@index([bankId])
  @@index([bankId, difficulty])
  @@map("questions")
}

// Exam snapshots survive deletion of the source question or bank.
model ExamQuestion {
  id                   String   @id @default(cuid())
  examId               String
  questionId           String?
  order                Int
  textSnapshot         String
  optionsSnapshot      String[]
  correctIndexSnapshot Int
  createdAt            DateTime @default(now())

  exam     Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([examId, order])
  @@index([examId])
  @@index([questionId])
  @@map("exam_questions")
}

model ExamAttempt {
  id             String    @id @default(cuid())
  examId         String
  studentId      String
  answers        Json
  // Accept only increasing autosave revisions.
  answersRevision Int      @default(0)
  correctCount   Int
  totalQuestions Int
  startedAt      DateTime
  // Null means the attempt is active.
  finishedAt     DateTime?
  endedByTimeout Boolean   @default(false)
  expiresAt      DateTime

  exam    Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@map("exam_attempts")
}

// Append-only history; the newest startDate defines the current plan.
model Subscription {
  id               String    @id @default(cuid())
  instructorId     String
  planId           PlanId
  startDate        DateTime  @default(now())
  endDate          DateTime?
  expiryNotifiedAt DateTime?

  instructor User      @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  payments   Payment[]

  @@index([instructorId])
  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(cuid())
  instructorId   String
  planId         PlanId
  amount         Int
  authority      String        @unique
  status         PaymentStatus @default(Pending)
  refId          Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscriptionId String?

  instructor   User          @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([instructorId])
  @@index([status])
  @@map("payments")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String?
  targetRoles Role[]
  title       String
  read        Boolean          @default(false)
  icon        NotificationIcon
  createdAt   DateTime         @default(now())

  user  User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  reads NotificationRead[]

  @@index([userId])
  @@map("notifications")
}

// Broadcast read/dismiss state is per recipient.
model NotificationRead {
  userId         String
  notificationId String
  readAt         DateTime @default(now())
  dismissedAt    DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([userId, notificationId])
  @@index([notificationId])
  @@map("notification_reads")
}

// Append-only audit records with minimal before/after values.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  admin User @relation("AdminActor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_logs")
}


enum PracticeStatus {
  Draft
  Published
  Archived
}

model PracticeSet {
  id           String @id @default(cuid())
  instructorId String
  title        String
  description  String @default("")
  status       PracticeStatus @default(Draft)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  instructor   User @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  groups       PracticeSetGroup[]
  questions    PracticeQuestion[]
  @@index([instructorId, createdAt])
  @@map("practice_sets")
}

model PracticeSetGroup {
  practiceId String
  groupId String
  practice PracticeSet @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([practiceId, groupId])
  @@index([groupId])
  @@map("practice_set_groups")
}

// Published snapshots are immutable, including after archive/resume.
model PracticeQuestion {
  id String @id @default(cuid())
  practiceId String
  sourceQuestionId String?
  position Int
  text String
  options String[]
  correctOptionIndex Int
  difficulty QuestionDifficulty
  practice PracticeSet @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  source Question? @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)
  attempts PracticeAttempt[]
  @@unique([practiceId, position])
  @@index([sourceQuestionId])
  @@map("practice_questions")
}

// Append-only answers. A retry reuses requestId and cannot increment history twice.
model PracticeAttempt {
  id String @id @default(cuid())
  questionId String
  studentId String
  requestId String
  selectedOptionIndex Int
  isCorrect Boolean
  createdAt DateTime @default(now())
  question PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@unique([studentId, requestId])
  @@index([studentId, questionId, createdAt])
  @@index([questionId])
  @@map("practice_attempts")
}

// Singleton; policy changes do not rewrite already approved records.
model ApprovalPolicy {
  id String @id @default("global")
  requireInstructorApproval Boolean @default(true)
  requireGroupApproval Boolean @default(false)
  revision Int @default(0)
  updatedAt DateTime @default(now()) @updatedAt
  @@map("approval_policy")
}
