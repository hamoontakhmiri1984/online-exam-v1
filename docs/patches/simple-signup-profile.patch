+import { Router } from 'express';
+import { requireAuth } from '../../middleware/requireAuth';
+import { asyncHandler } from '../../lib/asyncHandler';
+import { badRequest } from '../../lib/errors';
+import { imageUpload } from '../../lib/imageUpload';
+import { validateUploadedFile } from '../../lib/uploadValidation';
+import { readAvatar, replaceAvatar } from './avatar.service';
+const router = Router();
+router.use('/me/avatar', requireAuth, (_req, res, next) => {
+  res.setHeader('Cache-Control', 'no-store');
+  next();
+});
+router.get(
+  '/me/avatar',
+  asyncHandler(async (req, res) => {
+    res.json(await readAvatar(req.user!.sub));
+  }),
+);
+router.post(
+  '/me/avatar',
+  imageUpload.single('file'),
+  validateUploadedFile('image'),
+  asyncHandler(async (req, res) => {
+    if (!req.file) throw badRequest('تصویر را انتخاب کنید');
+    res.json(await replaceAvatar(req.user!.sub, req.file));
+  }),
+);
+router.delete(
+  '/me/avatar',
+  asyncHandler(async (req, res) => {
+    res.json(await replaceAvatar(req.user!.sub));
+  }),
+);
+export default router;
