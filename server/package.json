{
  "name": "exam-platform-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --require ts-node/register/transpile-only src/server.ts",
    "build": "tsc",
    "test": "node scripts/run-tests.cjs",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:superadmin": "ts-node --transpile-only scripts/create-superadmin.ts",
    "migrate:usernames": "ts-node --transpile-only scripts/migrate-usernames-to-identifier.ts",
    "migrate:uploads-to-storage": "ts-node --transpile-only scripts/migrate-uploads-to-storage.ts",
    "test:setup": "bash scripts/setup-test-env.sh",
    "test:otp": "node --test tests/otp.test.cjs",
    "test:otp:integration": "node --require ./tests/loadTestEnv.cjs --require ts-node/register/transpile-only --test tests/otp.integration.test.ts",
    "lint": "oxlint -c .oxlintrc.json src scripts tests --deny-warnings",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.{ts,cjs}\" \"tests/**/*.{ts,cjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.{ts,cjs}\" \"tests/**/*.{ts,cjs}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "@prisma/client": "^5.22.0",
    "@prometheus-io/client": "^0.16.1",
    "@sentry/node": "10.76.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pdf-lib": "1.17.1",
    "prisma": "^5.22.0",
    "redis": "^6.2.1",
    "sharp": "0.35.5",
    "socket.io": "^4.8.0",
    "xlsx": "file:../vendor/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.7.0",
    "oxlint": "^0.15.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "5.6.2"
  }
}
