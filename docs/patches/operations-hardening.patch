+  const a = stop('SIGTERM'); const b = stop('SIGINT');
+  assert.equal(a, b); await delay(5); assert.equal(calls, 1); assert.deepEqual(codes, []);
+  finish(); await a; assert.deepEqual(codes, [0]);
