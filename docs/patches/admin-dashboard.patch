@@ -0,0 +1,116 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const ts = require('typescript');
+function load(prisma) {
+  const module = { exports: {} };
+  const file = path.resolve(
+    __dirname,
+    '../src/routes/admin/dashboard.service.ts',
+  );
+  const code = ts.transpileModule(fs.readFileSync(file, 'utf8'), {
+    compilerOptions: {
+      module: ts.ModuleKind.CommonJS,
+      target: ts.ScriptTarget.ES2022,
+    },
+  }).outputText;
+  vm.runInNewContext(code, {
+    module,
+    exports: module.exports,
+    Date,
+    require(name) {
+      assert.equal(name, '../../lib/prisma');
+      return { prisma };
+    },
+  });
+  return module.exports;
+}
+test('admin dashboard status uses exact start/end boundaries and preserves drafts', () => {
+  const { dashboardExamStatus: status } = load({});
+  const start = new Date('2026-10-12T10:00:00Z');
+  for (const [time, expected] of [
+    ['09:59:59', 'upcoming'],
+    ['10:00:00', 'running'],
+    ['10:29:59', 'running'],
+    ['10:30:00', 'completed'],
+  ]) {
+    const now = new Date(`2026-10-12T${time}Z`);
+    assert.equal(status('Published', start, 30, now), expected);
+    assert.equal(status('Draft', start, 30, now), 'draft');
+  }
+});
+test('admin dashboard returns aggregate counts and only bounded recent exam metadata', async () => {
+  const now = new Date('2026-10-12T10:00:00Z');
+  let query;
+  const db = {
+    user: {
+      count: async ({ where }) =>
+        where.approvalStatus ? 2 : where.role === 'Instructor' ? 5 : 30,
+    },
+    group: {
+      count: async ({ where }) => {
+        assert.equal(where.approvalStatus, 'Pending');
+        return 3;
+      },
+    },
+    $queryRaw: async (strings, ...values) => {
+      assert.match(strings.join('?'), /status = 'Published'/);
+      assert.match(strings.join('?'), /INTERVAL '1 minute'/);
+      assert.equal(values[0], now);
+      return [{ count: 4n }];
+    },
+    exam: {
+      findMany: async (args) => {
+        query = args;
+        return [
+          {
+            id: 'e',
+            title: 'آزمون',
+            status: 'Published',
+            scheduledAt: now,
+            durationMinutes: 30,
+            instructor: { id: 'teacher-a', name: 'مدرس الف', username: 'a' },
+            _count: { attempts: 7 },
+          },
+        ];
+      },
+    },
+  };
+  const { getAdminDashboard } = load({
+    $transaction: async (fn, options) => {
+      assert.equal(options.isolationLevel, 'RepeatableRead');
+      return fn(db);
+    },
+  });
+  const result = JSON.parse(JSON.stringify(await getAdminDashboard(now)));
+  assert.deepEqual(result.counts, {
+    instructors: 5,
+    students: 30,
+    activeExams: 4,
+    pendingInstructors: 2,
+    pendingGroups: 3,
+  });
+  assert.equal(query.take, 8);
+  assert.equal(query.orderBy[1].id, 'desc');
+  assert.equal(query.select.instructor.select.email, undefined);
+  assert.equal(query.select.attempts, undefined);
+  assert.deepEqual(result.recentExams[0].instructor, {
+    id: 'teacher-a',
+    name: 'مدرس الف',
+  });
+  assert.equal(result.recentExams[0].participants, 7);
+  assert.equal(result.recentExams[0].status, 'running');
+});
+test('admin dashboard infrastructure failures propagate instead of returning zero statistics', async () => {
+  const failure = new Error('database unavailable');
+  await assert.rejects(
+    load({
+      $transaction: async () => {
+        throw failure;
+      },
+    }).getAdminDashboard(),
+    (error) => error === failure,
+  );
+});
