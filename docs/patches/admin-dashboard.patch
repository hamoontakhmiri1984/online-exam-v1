index 0000000..a51ca61
--- /dev/null
+++ b/server/src/routes/admin/dashboard.service.ts
@@ -0,0 +1,80 @@
+import { prisma } from '../../lib/prisma';
+
+export function dashboardExamStatus(
+  status: string,
+  scheduledAt: Date,
+  durationMinutes: number,
+  now: Date,
+) {
+  if (status === 'Draft') return 'draft' as const;
+  const start = scheduledAt.getTime();
+  if (now.getTime() >= start + durationMinutes * 60_000)
+    return 'completed' as const;
+  return now.getTime() >= start ? ('running' as const) : ('upcoming' as const);
+}
+
+export async function getAdminDashboard(now = new Date()) {
+  return prisma.$transaction(
+    async (db) => {
+      const instructors = await db.user.count({
+        where: { role: 'Instructor' },
+      });
+      const students = await db.user.count({ where: { role: 'Student' } });
+      const pendingInstructors = await db.user.count({
+        where: { role: 'Instructor', approvalStatus: 'Pending' },
+      });
+      const pendingGroups = await db.group.count({
+        where: { approvalStatus: 'Pending' },
+      });
+      // Published exams whose end time has not passed, including future exams.
+      const [active] = await db.$queryRaw<{ count: bigint }[]>`
+      SELECT COUNT(*) AS count FROM exams
+      WHERE status = 'Published'
+      AND "scheduledAt" + "durationMinutes" * INTERVAL '1 minute' > ${now}::timestamp
+    `;
+      const exams = await db.exam.findMany({
+        take: 8,
+        orderBy: [{ createdAt: 'desc' }, { id: 'desc' }],
+        select: {
+          id: true,
+          title: true,
+          status: true,
+          scheduledAt: true,
+          durationMinutes: true,
+          instructor: { select: { id: true, name: true, username: true } },
+          _count: { select: { attempts: true } },
+        },
+      });
+      return {
+        generatedAt: now.toISOString(),
+        counts: {
+          instructors,
+          students,
+          activeExams: Number(active.count),
+          pendingInstructors,
+          pendingGroups,
+        },
+        recentExams: exams.map((exam) => ({
+          id: exam.id,
+          title: exam.title,
+          scheduledAt: exam.scheduledAt.toISOString(),
+          status: dashboardExamStatus(
+            exam.status,
+            exam.scheduledAt,
+            exam.durationMinutes,
+            now,
+          ),
+          instructor: {
+            id: exam.instructor.id,
+            name:
+              exam.instructor.name ||
+              exam.instructor.username ||
+              'مدرس بدون نام',
+          },
+          participants: exam._count.attempts,
+        })),
+      };
+    },
+    { isolationLevel: 'RepeatableRead' },
+  );
+}
