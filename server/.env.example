# Local development only. Never overwrite an existing .env blindly.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://examuser:exampass@127.0.0.1:5432/examdb?schema=public
REDIS_URL=redis://127.0.0.1:6379
# Replace each secret with a different random value of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-your-own-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-your-own-refresh-secret-at-least-32-characters
GOOGLE_CLIENT_ID=configure-google-client-id
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
TRUST_PROXY=0
KAVENEGAR_API_KEY=
RESEND_API_KEY=
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=exam-platform-uploads
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
