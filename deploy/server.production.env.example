NODE_ENV=production
PORT=4000
# Use the exact passwords from compose.env; hex passwords avoid URL escaping issues.
DATABASE_URL=postgresql://examuser:REPLACE@postgres:5432/examdb
REDIS_URL=redis://:REPLACE@redis:6379
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
EXAM_TAB_SWITCH_LIMIT=3
TRUST_PROXY=1
CLIENT_URL=https://exam.your-domain.ir
SERVER_URL=https://exam.your-domain.ir/api
GOOGLE_CLIENT_ID=
KAVENEGAR_API_KEY=
RESEND_API_KEY=
OTP_EMAIL_FROM=
ZARINPAL_SANDBOX=false
ZARINPAL_MERCHANT_ID=
# Managed S3: copy region/endpoint/addressing mode from your provider.
S3_ENDPOINT=https://your-provider-endpoint
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
SENTRY_DSN=
METRICS_TOKEN=

# local (free built-in guide), openai-compatible, or anthropic. Server secrets only.
ASSISTANT_PROVIDER=local
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
ASSISTANT_DAILY_LIMIT=100
