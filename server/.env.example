# Run node scripts/setup-local.cjs from repository root to generate matching local credentials.
# Local development only. Never overwrite an existing .env blindly.
NODE_ENV=development
PORT=4000
DATABASE_URL=
REDIS_URL=
# Replace each secret with a different random value of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-your-own-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-your-own-refresh-secret-at-least-32-characters
JWT_RESET_SECRET=replace-with-your-own-reset-secret-at-least-32-characters
EXAM_TAB_SWITCH_LIMIT=3
# Optional: leave empty to disable Google authentication
GOOGLE_CLIENT_ID=
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
# Number of proxies (nginx/Cloudflare) in front of the server. Use 1 (or more) behind a proxy,
# otherwise every user shares one IP for rate limits and captcha.
TRUST_PROXY=0
KAVENEGAR_API_KEY=
RESEND_API_KEY=
# Email address on your verified Resend domain; required in production or with RESEND_API_KEY.
OTP_EMAIL_FROM=
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=exam-platform-uploads
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# Optional external error reporting and authenticated Prometheus scraping.
SENTRY_DSN=
METRICS_TOKEN=

# local (free built-in guide), openai-compatible, or anthropic. Server secrets only.
ASSISTANT_PROVIDER=local
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
ASSISTANT_DAILY_LIMIT=100
