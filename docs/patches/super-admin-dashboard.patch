+import { Link } from 'react-router-dom';
+import {
+  ClipboardList,
+  GraduationCap,
+  Hourglass,
+  Users,
+  XCircle,
+  type LucideIcon,
+} from 'lucide-react';
+import AppLayout from '../../../components/AppLayout/AppLayout';
+import Spinner from '../../../components/Spinner/Spinner';
+import Toast from '../../../components/Toast/Toast';
+import useAsyncData from '../../../hooks/useAsyncData';
+import {
+  getAdminDashboard,
+  type AdminDashboard as AdminDashboardData,
+  type AdminExamState,
+} from '../../../api/adminDashboardApi';
+import { formatDateOnly, formatExamDateTime } from '../../../utils/formatDate';
+import DashboardHeader from '../components/DashboardHeader';
+import { getCurrentUser } from '../../../api/authApi';
+
+const card =
+  'rounded-2xl border border-gray-100 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900';
+const fa = (n: number) => n.toLocaleString('fa-IR');
+
+function Stat({
+  icon: Icon,
+  label,
+  value,
+  tone,
+}: {
+  icon: LucideIcon;
+  label: string;
+  value: number;
+  tone: string;
+}) {
+  return (
+    <div className={`${card} flex items-center gap-4 p-5`}>
+      <div
+        className={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl ${tone}`}
+      >
+        <Icon size={22} />
+      </div>
+      <div className="min-w-0">
+        <p className="text-sm text-gray-500 dark:text-gray-400">{label}</p>
+        <p className="mt-1 text-2xl font-bold text-gray-900 dark:text-white">
+          {fa(value)}
+        </p>
+      </div>
+    </div>
+  );
+}
+
+function Queue({
+  title,
+  total,
+  to,
+  children,
+}: {
+  title: string;
+  total: number;
+  to: string;
+  children: React.ReactNode;
+}) {
+  return (
+    <div className={`${card} p-5`}>
+      <div className="mb-3 flex items-center justify-between gap-3">
+        <h3 className="font-semibold text-gray-900 dark:text-white">
+          {title}{' '}
+          <span className="text-sm font-normal text-gray-500 dark:text-gray-400">
+            ({fa(total)})
+          </span>
+        </h3>
+        <Link to={to} className="text-sm text-brand-600 hover:underline">
+          بررسی درخواست‌ها
+        </Link>
+      </div>
+      {total === 0 ? (
+        <p className="py-4 text-center text-sm text-gray-400">
+          درخواستی برای بررسی نیست
+        </p>
+      ) : (
+        <ul className="divide-y divide-gray-100 dark:divide-gray-800">
+          {children}
+        </ul>
+      )}
+    </div>
+  );
+}
+
+const stateLabel: Record<AdminExamState, string> = {
+  draft: 'پیش‌نویس',
+  upcoming: 'پیش‌رو',
+  completed: 'پایان‌یافته',
+};
+const stateTone: Record<AdminExamState, string> = {
+  draft: 'bg-gray-500/10 text-gray-600 dark:bg-gray-500/15 dark:text-gray-400',
+  upcoming:
+    'bg-accent-500/10 text-accent-600 dark:bg-accent-500/15 dark:text-accent-400',
+  completed:
+    'bg-success-500/10 text-success-600 dark:bg-success-500/15 dark:text-success-500',
+};
+
+function Content({ data }: { data: AdminDashboardData }) {
+  const { stats, attention, recentExams } = data;
+  return (
+    <>
+      <section className="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
+        <Stat
+          icon={GraduationCap}
+          label="مدرسان تأییدشده"
+          value={stats.approvedInstructors}
+          tone="bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300"
+        />
+        <Stat
+          icon={Users}
+          label="دانشجویان"
+          value={stats.students}
+          tone="bg-accent-500/10 text-accent-600 dark:bg-accent-500/15 dark:text-accent-400"
+        />
+        <Stat
+          icon={ClipboardList}
+          label="آزمون‌های فعال"
+          value={stats.activeExams}
+          tone="bg-success-500/10 text-success-600 dark:bg-success-500/15 dark:text-success-500"
+        />
+        <Stat
+          icon={Hourglass}
+          label="درخواست‌های منتظر بررسی"
+          value={stats.pendingRequests}
+          tone="bg-amber-500/10 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400"
+        />
+      </section>
+
+      <section className="mb-8">
+        <h2 className="mb-3 font-semibold text-gray-900 dark:text-white">
+          نیازمند رسیدگی
+        </h2>
+        <div className="grid grid-cols-1 gap-4 lg:grid-cols-2">
+          <Queue
+            title="تأیید مدرس"
+            total={attention.instructors.total}
+            to="/instructor-approvals"
+          >
+            {attention.instructors.items.map((i) => (
+              <li
+                key={i.id}
+                className="flex items-center justify-between gap-3 py-3 text-sm"
+              >
+                <div className="min-w-0">
+                  <p className="truncate font-medium text-gray-800 dark:text-gray-200">
+                    {i.name || 'بدون نام'}
+                  </p>
+                  <p
+                    dir="ltr"
+                    className="truncate text-right text-xs text-gray-500 dark:text-gray-400"
+                  >
+                    {i.email || i.phone || '—'}
+                  </p>
+                </div>
+                <span className="shrink-0 text-xs text-gray-500 dark:text-gray-400">
+                  {formatDateOnly(i.createdAt)}
+                </span>
+              </li>
+            ))}
+          </Queue>
+          <Queue
+            title="تأیید گروه"
+            total={attention.groups.total}
+            to="/settings"
+          >
+            {attention.groups.items.map((g) => (
+              <li
+                key={g.id}
+                className="flex items-center justify-between gap-3 py-3 text-sm"
+              >
+                <div className="min-w-0">
+                  <p className="truncate font-medium text-gray-800 dark:text-gray-200">
+                    {g.name}
+                  </p>
+                  <p className="truncate text-xs text-gray-500 dark:text-gray-400">
+                    {g.category} · {g.instructorName || 'بدون نام'}
+                  </p>
+                </div>
+                <span className="shrink-0 text-xs text-gray-500 dark:text-gray-400">
+                  {formatDateOnly(g.createdAt)}
+                </span>
+              </li>
+            ))}
+          </Queue>
+        </div>
+      </section>
+
+      <section className={`${card} overflow-hidden`}>
+        <div className="border-b border-gray-100 px-6 py-5 dark:border-gray-800">
+          <h2 className="font-semibold text-gray-900 dark:text-white">
+            آزمون‌های اخیر
+          </h2>
+        </div>
+        <div className="overflow-x-auto">
+          <table className="w-full min-w-170 text-right text-sm">
+            <thead>
+              <tr className="border-b border-gray-100 text-gray-500 dark:border-gray-800 dark:text-gray-400">
+                <th className="px-6 py-3 font-medium">عنوان</th>
+                <th className="px-6 py-3 font-medium">مدرس</th>
+                <th className="px-6 py-3 font-medium">زمان</th>
+                <th className="px-6 py-3 font-medium">وضعیت</th>
+                <th className="px-6 py-3 font-medium">شرکت‌کنندگان</th>
+                <th className="px-6 py-3 font-medium" />
+              </tr>
+            </thead>
+            <tbody>
+              {recentExams.length === 0 && (
+                <tr>
+                  <td
+                    colSpan={6}
+                    className="px-6 py-8 text-center text-gray-400"
+                  >
+                    هنوز آزمونی ثبت نشده
+                  </td>
+                </tr>
+              )}
+              {recentExams.map((e) => {
+                const base = `/instructors/${encodeURIComponent(e.instructorId)}`;
+                return (
+                  <tr
+                    key={e.id}
+                    className="border-b border-gray-100 last:border-0 dark:border-gray-800"
+                  >
+                    <td className="px-6 py-4 font-medium text-gray-800 dark:text-gray-200">
+                      {e.title}
+                    </td>
+                    <td className="px-6 py-4 text-gray-500 dark:text-gray-400">
+                      {e.instructorName || '—'}
+                    </td>
+                    <td className="px-6 py-4 text-gray-500 dark:text-gray-400">
+                      {formatExamDateTime(e.scheduledAt)}
+                    </td>
+                    <td className="px-6 py-4">
+                      <span
+                        className={`inline-flex rounded-full px-3 py-1 text-xs font-medium ${stateTone[e.status]}`}
+                      >
+                        {stateLabel[e.status]}
+                      </span>
+                    </td>
+                    <td className="px-6 py-4 text-gray-500 dark:text-gray-400">
+                      {fa(e.participants)}
+                    </td>
+                    <td className="space-x-3 space-x-reverse px-6 py-4 whitespace-nowrap">
+                      <Link
+                        to={`${base}?tab=exams`}
+                        className="text-brand-600 hover:underline"
+                      >
+                        جزئیات
+                      </Link>
+                      <Link
+                        to={`${base}?tab=results`}
+                        className="text-brand-600 hover:underline"
+                      >
+                        نتایج
+                      </Link>
+                    </td>
+                  </tr>
+                );
+              })}
+            </tbody>
+          </table>
+        </div>
+      </section>
+    </>
+  );
+}
+
+// داشبورد مدیر ارشد: یک درخواستِ فقط‌خواندنی؛ مدرس/دانشجو هرگز این کامپوننت
+// (و در نتیجه این درخواست) را اجرا نمی‌کنند
+export default function AdminDashboard() {
+  const user = getCurrentUser();
+  const { data, loading, error, clearError } =
+    useAsyncData<AdminDashboardData | null>(
+      getAdminDashboard,
+      null,
+      'دریافت اطلاعات داشبورد با خطا مواجه شد'
+    );
+  return (
+    <AppLayout title="داشبورد">
+      {error && (
+        <Toast
+          message={error}
+          tone="danger"
+          icon={XCircle}
+          onDismiss={clearError}
+        />
+      )}
+      <DashboardHeader user={user} />
+      {loading ? <Spinner /> : data && <Content data={data} />}
+    </AppLayout>
+  );
+}
diff --git a/client/tests/adminDashboard.test.ts b/client/tests/adminDashboard.test.ts
