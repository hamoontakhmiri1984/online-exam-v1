index 0000000..c6a596a
--- /dev/null
+++ b/client/tests/adminDashboard.test.ts
@@ -0,0 +1,87 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createElement } from 'react';
+import { renderToString } from 'react-dom/server';
+import { MemoryRouter } from 'react-router-dom';
+import AdminOverview from '../src/pages/DashboardPage/components/AdminOverview';
+import AdminRecentExams from '../src/pages/DashboardPage/components/AdminRecentExams';
+import ExamRow from '../src/pages/ExamsPage/components/ExamRow';
+import type { ComponentProps } from 'react';
+const render = (element: ReturnType<typeof createElement>) =>
+  renderToString(createElement(MemoryRouter, {}, element));
+test('admin dashboard shows owner, statuses and read-only question links', () => {
+  const html = render(
+    createElement(AdminRecentExams, {
+      exams: [
+        {
+          id: 'exam-a',
+          title: 'آزمون الف',
+          scheduledAt: '2026-10-12T10:00:00Z',
+          status: 'running',
+          instructor: { id: 'teacher-a', name: 'مدرس الف' },
+          participants: 3,
+        },
+      ],
+    }),
+  );
+  assert.ok(html.includes('مدرس الف'));
+  assert.ok(html.includes('/instructors/teacher-a'));
+  assert.ok(html.includes('/exams/exam-a/questions'));
+  assert.ok(html.includes('در حال برگزاری'));
+  for (const forbidden of ['شروع آزمون', 'حذف', 'ویرایش', 'انتشار آزمون'])
+    assert.ok(!html.includes(forbidden));
+});
+test('admin overview shows explicit empty queue and actual pending links', () => {
+  const counts = {
+    instructors: 2,
+    students: 10,
+    activeExams: 3,
+    pendingInstructors: 0,
+    pendingGroups: 0,
+  };
+  assert.ok(
+    render(createElement(AdminOverview, { counts })).includes(
+      'درخواست منتظر بررسی ندارید',
+    ),
+  );
+  const html = render(
+    createElement(AdminOverview, {
+      counts: { ...counts, pendingInstructors: 1, pendingGroups: 2 },
+    }),
+  );
+  assert.ok(html.includes('/instructor-approvals'));
+  assert.ok(html.includes('/settings'));
+});
+test('exam start action requires explicit Student permission', () => {
+  const props = {
+    exam: {
+      id: 'e',
+      title: 'Test',
+      category: 'Test',
+      date: '2026-10-12T10:00:00Z',
+      status: 'upcoming',
+    },
+    canManage: false,
+    participantCount: 0,
+    onTake() {},
+    onOpenQuestions() {},
+    onEdit() {},
+    onDelete() {},
+    onPublish() {},
+    onUnpublish() {},
+  } as ComponentProps<typeof ExamRow>;
+  const row = (canTake: boolean) =>
+    render(
+      createElement(
+        'table',
+        {},
+        createElement(
+          'tbody',
+          {},
+          createElement(ExamRow, { ...props, canTake }),
+        ),
+      ),
+    );
+  assert.ok(!row(false).includes('شروع آزمون'));
+  assert.ok(row(true).includes('شروع آزمون'));
+});
