+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createElement } from 'react';
+import { renderToString } from 'react-dom/server';
+import { MemoryRouter } from 'react-router-dom';
+import OtpStep from '../src/components/SignupForm/OtpStep';
+import OtpVerifyForm from '../src/components/LoginForm/OtpVerifyForm';
+import { validateIdentityField } from '../src/components/SignupForm/signup.validation';
+import {
+  normalizeIdentifier,
+  detectIdentifierType,
+} from '../src/utils/identifier';
+import { googleLogin } from '../src/api/authApi';
+
+test('signup OTP disables all input/actions while verification or resend is in flight', () => {
+  for (const busy of [
+    { loading: true, resending: false },
+    { loading: false, resending: true },
+  ]) {
+    const html = renderToString(
+      createElement(OtpStep, {
+        identifier: 'user@example.com',
+        code: '123456',
+        error: '',
+        resendSignal: 0,
+        onCodeChange() {},
+        onBack() {},
+        onResend() {},
+        onSubmit() {},
+        ...busy,
+      }),
+    );
+    const controls = html.match(/<(?:button|input)\b[^>]*>/g) ?? [];
+    assert.equal(controls.length, 9);
+    assert.ok(controls.every((tag) => tag.includes('disabled')));
+  }
+});
+test('OTP fields are labelled, support full-code autofill and fit narrow screens', () => {
+  const html = renderToString(
+    createElement(
+      MemoryRouter,
+      {},
+      createElement(OtpVerifyForm, {
+        identifier: 'user@example.com',
+        rememberMe: false,
+        onSuccess() {},
+        onBack() {},
+      }),
+    ),
+  );
+  assert.equal((html.match(/aria-label="رقم/g) ?? []).length, 6);
+  assert.ok(html.includes('maxLength="6"'));
+  assert.ok(html.includes('min-w-0'));
+});
+test('identifier normalization and signup/reset password limits match supported inputs', () => {
+  const phone = '+۹۸۹۱۲۳۴۵۶۷۸۹';
+  assert.equal(detectIdentifierType(phone), 'PHONE');
+  assert.equal(normalizeIdentifier(phone, 'PHONE'), '09123456789');
+  assert.equal(
+    normalizeIdentifier(' User@Example.com ', 'EMAIL'),
+    'user@example.com',
+  );
+  const values = {
+    name: 'Ali',
+    identifier: 'u@example.com',
+    password: 'abc123',
+    confirmPassword: 'abc123',
+  };
+  assert.equal(validateIdentityField('password', values), null);
+  for (const password of ['123456', 'abcdef', 'a1'.repeat(37)])
+    assert.ok(validateIdentityField('password', { ...values, password }));
+});
+test('Google account creation is explicit and pending approval does not create a client session', async () => {
+  const original = globalThis.fetch;
+  const requests: unknown[] = [];
+  globalThis.fetch = (async (_url, init) => {
+    requests.push(JSON.parse(String(init?.body)));
+    return new Response(
+      JSON.stringify(
+        requests.length === 1
+          ? { registrationRequired: true }
+          : { pendingApproval: true, message: 'منتظر تأیید' },
+      ),
+      { status: 200 },
+    );
+  }) as typeof fetch;
+  try {
+    assert.equal((await googleLogin('token')).status, 'registration_required');
+    assert.equal(
+      (await googleLogin('token', { role: 'Instructor', name: 'Teacher' }))
+        .status,
+      'pending_approval',
+    );
+    assert.deepEqual(requests, [
+      { idToken: 'token' },
+      {
+        idToken: 'token',
+        registration: { role: 'Instructor', name: 'Teacher' },
+      },
+    ]);
+  } finally {
+    globalThis.fetch = original;
+  }
+});
diff --git a/docs/login-completion.fa.md b/docs/login-completion.fa.md
new file mode 100644
index 0000000..88c3112
--- /dev/null
+++ b/docs/login-completion.fa.md
@@ -0,0 +1,46 @@
+# تکمیل ورود و ثبت‌نام
+
+مبنای بررسی: commit `4df0548` روی main. این تغییرات نیاز به migration جدید ندارند.
+
+## رفتار
+
+- ابتدا شماره موبایل یا ایمیل وارد می‌شود؛ «ادامه» هیچ کدی ارسال نمی‌کند.
+- کاربر رمز یا دریافت کد را انتخاب می‌کند. گوگل فقط در مرحله اول حضور دارد.
+- حساب موجود گوگل وارد می‌شود. برای حساب جدید، پس از تأیید گوگل نام و نقش کارآموز/مدرس دریافت می‌شود. نقش مدیر قابل انتخاب نیست.
+- مدرس جدید از سیاست تأیید مدیر پیروی می‌کند؛ نقش و رد/تأیید حساب موجود با ثبت‌نام گوگل تغییر نمی‌کند.
+- اعتبار گوگل در درخواست ساخت حساب دوباره بررسی می‌شود. credential تنها در حافظه فرم است، نه URL یا localStorage.
+- بازیابی رمز، شناسه مرحله رمز را نگه می‌دارد؛ شماره فارسی نرمال می‌شود و شرایط رمز قبل از درخواست بررسی می‌شوند.
+- ارسال مجدد و تأیید کد هم‌زمان اجرا نمی‌شوند. شش رقم کامل ورود یک‌بار خودکار تأیید می‌شوند.
+- تم بین اجزای صفحه مشترک است. جای دکمه ثابت و ورودی کد در موبایل ۳۲۰ پیکسل بدون خروج از عرض صفحه است.
+- اصلاح قبلی پیام فارسی خطا و جداسازی محدودیت ارسال کد نیز در این بسته اعمال شده است.
+
+## تنظیم گوگل
+
+`GOOGLE_CLIENT_ID` در سرور و `VITE_GOOGLE_CLIENT_ID` در کلاینت باید مربوط به یک OAuth client باشند. origin کلاینت Codespace باید در تنظیمات Google مجاز باشد. نبود تنظیم کلاینت به‌جای دکمه خراب، پیام عدم دسترسی نشان می‌دهد.
+
+## تست
+
+از ریشه پروژه:
+
+```sh
+npm test -w client
+node --test server/tests/googleAuth.test.cjs server/tests/authErrors.test.cjs server/tests/sessionAccess.test.cjs
+npm run build -w server
+npm run build -w client
+npm run lint -w client
+```
+
+تست دستی با سرور و سرویس‌های Codespace روشن:
+
+1. شماره فارسی / ایمیل → ادامه؛ هنوز کد ارسال نشود. رمز اشتباه پیام فارسی بدهد.
+2. فراموشی رمز از مرحله رمز → شناسه پر باشد؛ کد واقعی، رمز جدید و ورود با آن را بررسی کنید.
+3. روش کد → دریافت، چسباندن شش رقم، کد اشتباه و ارسال مجدد؛ هر بار فقط یک درخواست.
+4. گوگل حساب موجود → ورود. گوگل حساب جدید → انتخاب نقش و ساخت حساب.
+5. تأیید مدرس روشن → حساب مدرس جدید منتظر مدیر؛ خاموش → ورود. حساب ردشده همچنان مسدود.
+6. تغییر تم → رفتن بین ورود/ثبت‌نام/فراموشی رمز؛ ورودی و ویجت گوگل با تم هماهنگ بمانند.
+
+در محیط بررسی، ۸۰ تست کلاینت و ۲۲ تست هدفمند سرور، build هر دو و lint موفق بودند. تست مرورگر با پاسخ‌های API و SDK گوگل شبیه‌سازی‌شده انجام شد. ارسال واقعی پیامک/ایمیل، OAuth واقعی و تراکنش‌های پایگاه داده Codespace باید در محیط شما بررسی شوند.
+
+## مشکل commit
+
+در نسخه بررسی‌شده hook اجباری commit یا تنظیم Husky پیدا نشد. علت خطای commit Codespace بدون خروجی همان دستور قابل تشخیص نیست. از حذف تغییرات، reset سخت و دور زدن hook بدون شناخت خطا استفاده نکنید. اعمال‌کننده در صورت تداخل پیش از تغییر فایل‌ها متوقف می‌شود؛ خروجی تداخل و خطای commit را ارسال کنید.
