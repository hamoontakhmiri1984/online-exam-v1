@@ -0,0 +1,49 @@
+import { randomUUID } from 'node:crypto';
+import { prisma } from '../../lib/prisma';
+import {
+  uploadObject,
+  deleteObject,
+  getSignedDownloadUrl,
+} from '../../lib/storage';
+import { extensionForImageMimeType } from '../../lib/imageUpload';
+
+async function discard(key: string) {
+  await deleteObject(key).catch(() =>
+    console.error('Profile image cleanup unavailable'),
+  );
+}
+export async function readAvatar(userId: string) {
+  const user = await prisma.user.findUniqueOrThrow({
+    where: { id: userId },
+    select: { avatarKey: true },
+  });
+  return {
+    url: user.avatarKey ? await getSignedDownloadUrl(user.avatarKey) : null,
+  };
+}
+export async function replaceAvatar(
+  userId: string,
+  file?: { buffer: Buffer; mimetype: string },
+) {
+  const key = file
+    ? `avatars/${userId}/${randomUUID()}.${extensionForImageMimeType(file.mimetype)}`
+    : null;
+  if (file && key) await uploadObject(key, file.buffer, file.mimetype);
+  let previous: string | null;
+  try {
+    previous = await prisma.$transaction(async (db) => {
+      await db.$queryRaw`SELECT id FROM users WHERE id = ${userId} FOR UPDATE`;
+      const user = await db.user.findUniqueOrThrow({
+        where: { id: userId },
+        select: { avatarKey: true },
+      });
+      await db.user.update({ where: { id: userId }, data: { avatarKey: key } });
+      return user.avatarKey;
+    });
+  } catch (error) {
+    if (key) await discard(key);
+    throw error;
+  }
+  if (previous) await discard(previous);
+  return { url: key ? await getSignedDownloadUrl(key) : null };
+}
