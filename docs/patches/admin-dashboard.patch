@@ -0,0 +1,80 @@
+import AppLayout from '../../components/AppLayout/AppLayout';
+import Spinner from '../../components/Spinner/Spinner';
+import { Link } from 'react-router-dom';
+import {
+  getAdminDashboard,
+  type AdminDashboardData,
+} from '../../api/adminDashboardApi';
+import useAsyncData from '../../hooks/useAsyncData';
+import AdminOverview from './components/AdminOverview';
+import AdminRecentExams from './components/AdminRecentExams';
+export default function AdminDashboard() {
+  const { data, loading, error, refetch } =
+    useAsyncData<AdminDashboardData | null>(
+      getAdminDashboard,
+      null,
+      'دریافت آمار سامانه ممکن نشد؛ دوباره تلاش کنید.',
+    );
+  return (
+    <AppLayout title="داشبورد">
+      <header className="mb-6 flex flex-wrap items-center justify-between gap-4">
+        <div>
+          <h1 className="text-2xl font-bold">نمای کلی سامانه</h1>
+          <p className="mt-2 text-sm text-gray-500 dark:text-gray-400">
+            وضعیت آموزش، آزمون‌ها و درخواست‌های نیازمند بررسی
+          </p>
+        </div>
+        <div className="flex gap-3 text-sm">
+          <Link
+            to="/reports"
+            className="rounded-xl border border-gray-200 px-4 py-2 dark:border-gray-700"
+          >
+            گزارش‌ها
+          </Link>
+          <button
+            type="button"
+            onClick={() => {
+              refetch();
+            }}
+            disabled={loading}
+            className="rounded-xl bg-brand-600 px-4 py-2 text-white disabled:opacity-50"
+          >
+            {loading ? 'در حال دریافت…' : 'به‌روزرسانی'}
+          </button>
+        </div>
+      </header>
+      {loading ? (
+        <div role="status" aria-label="دریافت آمار">
+          <Spinner />
+        </div>
+      ) : error ? (
+        <div
+          role="alert"
+          className="rounded-xl border border-danger-200 bg-danger-50 p-5 text-danger-700 dark:border-danger-900 dark:bg-danger-950/30 dark:text-danger-300"
+        >
+          {error}
+          <button
+            type="button"
+            onClick={() => {
+              refetch();
+            }}
+            className="ms-3 underline"
+          >
+            تلاش مجدد
+          </button>
+        </div>
+      ) : (
+        data && (
+          <>
+            <AdminOverview counts={data.counts} />
+            <AdminRecentExams exams={data.recentExams} />
+            <p className="mt-4 text-xs text-gray-500 dark:text-gray-400">
+              آخرین دریافت آمار:{' '}
+              {new Date(data.generatedAt).toLocaleString('fa-IR')}
+            </p>
+          </>
+        )
+      )}
+    </AppLayout>
+  );
+}
