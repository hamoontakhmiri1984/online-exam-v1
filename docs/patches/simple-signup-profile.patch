diff --git a/server/tests/profileAvatar.test.cjs b/server/tests/profileAvatar.test.cjs
new file mode 100644
index 0000000..7196f2d
--- /dev/null
+++ b/server/tests/profileAvatar.test.cjs
@@ -0,0 +1,96 @@
+const test = require('node:test'),
+  assert = require('node:assert/strict'),
+  fs = require('node:fs'),
+  path = require('node:path'),
+  vm = require('node:vm'),
+  ts = require('typescript');
+function setup({ failure = false } = {}) {
+  let current = 'avatars/user/old.png';
+  const calls = [];
+  const db = {
+    $queryRaw: async (strings, ...values) => {
+      calls.push(['lock', values[0]]);
+    },
+    user: {
+      findUniqueOrThrow: async ({ where }) => {
+        calls.push(['read', where.id]);
+        return { avatarKey: current };
+      },
+      update: async ({ where, data }) => {
+        calls.push(['update', where.id]);
+        if (failure) throw Error('db unavailable');
+        current = data.avatarKey;
+      },
+    },
+  };
+  const mocks = {
+    'node:crypto': { randomUUID: () => 'new-id' },
+    '../../lib/prisma': {
+      prisma: { ...db, $transaction: async (fn) => fn(db) },
+    },
+    '../../lib/storage': {
+      uploadObject: async (key) => calls.push(['upload', key]),
+      deleteObject: async (key) => calls.push(['delete', key]),
+      getSignedDownloadUrl: async (key) => 'signed:' + key,
+    },
+    '../../lib/imageUpload': { extensionForImageMimeType: () => 'png' },
+  };
+  const module = { exports: {} };
+  const file = path.resolve(__dirname, '../src/routes/auth/avatar.service.ts');
+  vm.runInNewContext(
+    ts.transpileModule(fs.readFileSync(file, 'utf8'), {
+      compilerOptions: {
+        module: ts.ModuleKind.CommonJS,
+        target: ts.ScriptTarget.ES2022,
+      },
+    }).outputText,
+    {
+      module,
+      exports: module.exports,
+      console,
+      require: (n) => {
+        if (!(n in mocks)) throw Error(n);
+        return mocks[n];
+      },
+    },
+  );
+  return {
+    ...module.exports,
+    calls,
+    get current() {
+      return current;
+    },
+  };
+}
+test('avatar replacement locks own user, uploads privately and deletes prior image only after save', async () => {
+  const s = setup();
+  const result = await s.replaceAvatar('user', {
+    buffer: Buffer.from('image'),
+    mimetype: 'image/png',
+  });
+  assert.equal(result.url, 'signed:avatars/user/new-id.png');
+  assert.deepEqual(
+    s.calls.map((c) => c[0]),
+    ['upload', 'lock', 'read', 'update', 'delete'],
+  );
+  assert.equal(s.calls[1][1], 'user');
+  assert.equal(s.calls.at(-1)[1], 'avatars/user/old.png');
+});
+test('avatar failed DB update cleans new upload and preserves previous image', async () => {
+  const s = setup({ failure: true });
+  await assert.rejects(
+    s.replaceAvatar('user', {
+      buffer: Buffer.from('image'),
+      mimetype: 'image/png',
+    }),
+  );
+  assert.equal(s.current, 'avatars/user/old.png');
+  assert.deepEqual(s.calls.at(-1), ['delete', 'avatars/user/new-id.png']);
+});
+test('avatar removal and private read are scoped to requested authenticated user', async () => {
+  const s = setup();
+  assert.equal((await s.readAvatar('user')).url, 'signed:avatars/user/old.png');
+  assert.equal((await s.replaceAvatar('user')).url, null);
+  assert.equal(s.current, null);
+  assert.equal((await s.readAvatar('user')).url, null);
+});
