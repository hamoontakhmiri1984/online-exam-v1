@@ -0,0 +1,101 @@
+import { useEffect, useState, useRef } from 'react';
+import { getAvatar, uploadAvatar, deleteAvatar } from '../../../api/profileApi';
+import { ApiError } from '../../../lib/apiClient';
+export default function AvatarSection() {
+  const [url, setUrl] = useState<string | null>(null);
+  const [busy, setBusy] = useState(true);
+  const [error, setError] = useState('');
+  const pending = useRef(false);
+  useEffect(() => {
+    let active = true;
+    getAvatar()
+      .then((result) => {
+        if (active) setUrl(result.url);
+      })
+      .catch(() => {
+        if (active) setError('دریافت عکس ممکن نشد');
+      }).finally(() => { if (active) setBusy(false); });
+    return () => {
+      active = false;
+    };
+  }, []);
+  async function save(file?: File) {
+    if (pending.current) return;
+    if (
+      file &&
+      (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) ||
+        file.size > 5 * 1024 * 1024)
+    ) {
+      setError('تصویر JPG، PNG یا WebP تا ۵ مگابایت انتخاب کنید');
+      return;
+    }
+    pending.current = true;
+    setBusy(true);
+    setError('');
+    try {
+      const result = await (file ? uploadAvatar(file) : deleteAvatar());
+      setUrl(result.url);
+    } catch (e) {
+      setError(e instanceof ApiError ? e.message : 'ذخیرهٔ عکس ممکن نشد');
+    } finally {
+      pending.current = false;
+      setBusy(false);
+    }
+  }
+  return (
+    <section className="rounded-2xl border border-gray-100 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
+      <h2 className="mb-4 font-semibold">عکس پروفایل</h2>
+      <div className="mb-4 flex items-center gap-4">
+        {url ? (
+          <img
+            src={url}
+            alt="عکس پروفایل شما"
+            className="h-20 w-20 rounded-full object-cover"
+          />
+        ) : (
+          <div className="flex h-20 w-20 items-center justify-center rounded-full bg-brand-50 text-brand-600 dark:bg-brand-950 dark:text-brand-300">
+            بدون عکس
+          </div>
+        )}
+        <p className="text-xs text-gray-500">
+          اختیاری · JPG، PNG یا WebP · حداکثر ۵ مگابایت
+        </p>
+      </div>
+      <label htmlFor="profile-image" className="mb-2 block text-sm">
+        انتخاب عکس
+      </label>
+      <input
+        id="profile-image"
+        type="file"
+        accept="image/jpeg,image/png,image/webp"
+        disabled={busy}
+        className="w-full text-sm"
+        onChange={(e) => {
+          const file = e.target.files?.[0];
+          e.target.value = '';
+          if (file) void save(file);
+        }}
+      />
+      {url && (
+        <button
+          type="button"
+          disabled={busy}
+          onClick={() => void save()}
+          className="mt-3 text-sm text-danger-600"
+        >
+          حذف عکس
+        </button>
+      )}
+      {busy && (
+        <p role="status" className="mt-3 text-sm">
+          در حال ذخیره…
+        </p>
+      )}
+      {error && (
+        <p role="alert" className="mt-3 text-sm text-danger-600">
+          {error}
+        </p>
+      )}
+    </section>
+  );
+}
