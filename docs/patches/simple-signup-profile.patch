+++ b/client/src/api/profileApi.ts
@@ -0,0 +1,30 @@
+import type { MeResponse } from './auth/auth.types';
+import { userFromMe } from './auth/auth.utils';
+import { setCurrentUser } from './auth/auth.session';
+import { apiMultipartRequest, apiRequest } from '../lib/apiClient';
+export const getProfileAccess = () =>
+  apiRequest<{ hasPassword: boolean; recoveryIdentifier: string | null }>(
+    '/auth/me',
+  );
+export const getAvatar = () =>
+  apiRequest<{ url: string | null }>('/auth/me/avatar');
+export const deleteAvatar = () =>
+  apiRequest<{ url: string | null }>('/auth/me/avatar', { method: 'DELETE' });
+export function uploadAvatar(file: File) {
+  const form = new FormData();
+  form.append('file', file);
+  return apiMultipartRequest<{ url: string | null }>('/auth/me/avatar', form);
+}
+
+export async function saveProfile(body: {
+  name?: string;
+  organizationName?: string;
+}) {
+  const data = await apiRequest<MeResponse>('/auth/me', {
+    method: 'PATCH',
+    body,
+  });
+  const user = userFromMe(data);
+  setCurrentUser(user);
+  return user;
+}
