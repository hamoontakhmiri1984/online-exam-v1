{
  "name": "exam-platform-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint -c .oxlintrc.json --ignore-pattern=dist --ignore-pattern=.test-dist src tests scripts vite.config.ts",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"tests/**/*.{ts,tsx,js,jsx,json,css,md}\" \"scripts/*.{ts,mjs,cjs}\" \"vite.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"tests/**/*.{ts,tsx,js,jsx,json,css,md}\" \"scripts/*.{ts,mjs,cjs}\" \"vite.config.ts\""
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@react-oauth/google": "^0.12.1",
    "framer-motion": "^11.11.0",
    "jalaali-js": "^1.2.6",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.13.0",
    "socket.io-client": "^4.8.0",
    "xlsx": "file:../vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.12",
    "oxlint": "^0.15.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "vite": "^6.0.0",
    "prettier": "^3.9.10"
  }
}
