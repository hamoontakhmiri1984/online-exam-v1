+import { useEffect, useState } from 'react';
+import { Link } from 'react-router-dom';
+import { getProfileAccess } from '../../../api/profileApi';
+export default function PasswordSetupSection() {
+  const [data, setData] = useState<Awaited<
+    ReturnType<typeof getProfileAccess>
+  > | null>(null);
+  const [error, setError] = useState('');
+  useEffect(() => {
+    let active = true;
+    getProfileAccess()
+      .then((value) => {
+        if (active) setData(value);
+      })
+      .catch(() => {
+        if (active)
+          setError('دریافت وضعیت رمز ممکن نشد؛ صفحه را دوباره باز کنید.');
+      });
+    return () => {
+      active = false;
+    };
+  }, []);
+  return (
+    <section className="rounded-2xl border border-gray-100 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
+      <h2 className="mb-3 font-semibold">رمز عبور</h2>
+      {error ? (
+        <p role="alert" className="text-sm text-danger-600">
+          {error}
+        </p>
+      ) : !data ? (
+        <p className="text-sm">در حال بررسی…</p>
+      ) : (
+        <>
+          <p className="mb-4 text-sm text-gray-500">
+            {data.hasPassword
+              ? 'برای تغییر رمز، ابتدا مالکیت شماره یا ایمیل خود را تأیید کنید.'
+              : 'ورود با کد یک‌بارمصرف فعال است. در صورت تمایل می‌توانید رمز عبور هم تنظیم کنید.'}
+          </p>
+          <Link
+            to="/forgot-password"
+            state={{ identifier: data.recoveryIdentifier ?? '' }}
+            className="text-sm text-brand-600 dark:text-brand-300"
+          >
+            {data.hasPassword ? 'تغییر رمز عبور' : 'تنظیم رمز عبور'}
+          </Link>
+        </>
+      )}
+    </section>
+  );
+}
